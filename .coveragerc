[run]
branch = True
source = src/neuravo
parallel = True
omit =
    */site-packages/*
    */distutils/*

[report]
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    pass
    if 0:
    if False:

[html]
directory = htmlcov

[paths]
source =
    src/neuravo
    */site-packages/neuravo
